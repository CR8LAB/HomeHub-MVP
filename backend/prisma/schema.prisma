generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String? @unique
  phoneNumber  String?
  passwordHash String?
  isVerified   Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  households HouseholdMember[]
  agencies   AgencyMember[]

  systemRole SystemRole @default(USER)
}

model Household {
  id         Int      @id @default(autoincrement())
  familyName String
  city       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members           HouseholdMember[]
  activationCode    ActivationCode?
  homeInfo          HomeInfo?
  emergencyContacts EmergencyContact[]
  todos             Todo[]
}

model HouseholdMember {
  id Int @id @default(autoincrement())

  userId      Int
  householdId Int

  role Role @default(MEMBER)

  joinedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@unique([userId, householdId])
}

enum Role {
  OWNER
  MEMBER
}

model ActivationCode {
  id Int @id @default(autoincrement())

  code String @unique

  agencyId    Int?
  householdId Int? @unique

  isClaimed Boolean @default(false)
  isEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  claimedAt DateTime?

  agency    Agency?    @relation(fields: [agencyId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([agencyId])

  printStatus PrintStatus @default(PENDING)
printedAt   DateTime?
}

model HomeInfo {
  id          Int @id @default(autoincrement())
  householdId Int @unique

  nickname            String?
  address             String?
  municipalityAccount String?

  electricityMeter String?
  waterMeter       String?
  electricityBox   String?

  municipalityPhone String?
  electricityFaults String?
  waterFaults       String?
  refuseDay         String?

  securityCompany String?
  securityPhone   String?
  alarmCompany    String?
  alarmPhone      String?

  gateCode     String?
  wifiName     String?
  wifiPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id          Int @id @default(autoincrement())
  householdId Int

  name  String
  phone String
  type  String
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Todo {
  id          Int @id @default(autoincrement())
  householdId Int

  title     String
  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Agency {
  id         Int    @id @default(autoincrement())
  name       String
  slug       String @unique
  codePrefix String? @unique

  city       String?
  logoUrl    String?
  isActive   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         AgencyMember[]
  activationCodes ActivationCode[]

  status        AgencyStatus  @default(PENDING)
paymentStatus PaymentStatus @default(PENDING)
}

model AgencyMember {
  id Int @id @default(autoincrement())

  userId   Int
  agencyId Int

  role AgencyRole @default(AGENT)

  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([userId, agencyId])
  @@index([agencyId])
}

enum AgencyRole {
  ADMIN
  AGENT
}

enum AgencyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PrintStatus {
  PENDING
  PRINTED
}

enum SystemRole {
  USER
  SUPER_ADMIN
}